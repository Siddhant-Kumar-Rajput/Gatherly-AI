# Copy to .env.local and fill from Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check reCAPTCHA Enterprise site key for the production web domain.
# Never commit an App Check debug token. Set this to a project-specific site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Gemini Developer API key from Google AI Studio. Used for event plans and
# Google Maps-grounded place discovery (Gemini 2.5 Flash).
VITE_GEMINI_API_KEY=
