# Copy to .env.local and fill from Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check reCAPTCHA Enterprise site key for the production web domain.
# Never commit an App Check debug token. Set this to a project-specific site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional: enables real Google Places searches and venue details.
# Restrict this browser key by HTTP referrer and only the Maps JavaScript + Places APIs.
VITE_GOOGLE_MAPS_API_KEY=
